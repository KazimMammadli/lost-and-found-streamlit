# ============================================================
# Streamlit Cloud Secrets — Example Template
# ============================================================
# Copy this file's contents into:
#   Streamlit Cloud  →  App settings  →  Secrets
#
# Do NOT commit your real secrets file. The deploy repo's
# .gitignore excludes .streamlit/secrets.toml on purpose.
# ============================================================

# --- AI providers (OpenAI only for this deployment) ---
LLM_PROVIDER = "openai"
LLM_MODEL = "gpt-4o"
OPENAI_API_KEY = "sk-REPLACE-WITH-YOUR-REAL-OPENAI-KEY"

# --- Embeddings ---
EMBEDDING_PROVIDER = "openai"
EMBEDDING_MODEL = "text-embedding-3-small"

# --- Database (SQLite is fine for the demo; ephemeral on Streamlit Cloud) ---
DATABASE_URL = "sqlite+aiosqlite:///./dev.db"

# --- Image storage ---
IMAGES_DIR = "data/images"
MAX_IMAGE_BYTES = 5242880

# --- Concurrency / rate limits ---
SEMAPHORE_LIMIT = 10
AI_CALL_TIMEOUT_S = 30.0
AI_CALL_TPM_LIMIT = 40000

# --- Logging / tracing ---
LOG_LEVEL = "INFO"
ENABLE_TRACING = false
OTLP_ENDPOINT = "http://localhost:4317"

# --- Cost report path ---
COST_LOG_PATH = "artefacts/cost.jsonl"

# --- (Intentionally omitted) ---
# SECONDARY_LLM_PROVIDER = ""   # disables failover (default behaviour)
# GOOGLE_API_KEY = ""           # not needed when failover is disabled
# ANTHROPIC_API_KEY = ""        # not needed when failover is disabled
